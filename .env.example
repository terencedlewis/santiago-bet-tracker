# Required for normal user access
APP_PASSWORD=your-user-password-here

# Required for admin access
ADMIN_PASSWORD=your-admin-password-here

# Optional: strong secret used to sign authenticated sessions
# AUTH_SESSION_SECRET=replace-with-a-long-random-string

# Optional: disable auth for local testing (`true` to bypass password and session checks)
# DISABLE_AUTH=true

# Optional: session cookie lifetime in seconds (default: 2592000 = 30 days)
# AUTH_COOKIE_MAX_AGE_SECONDS=2592000

# Optional: override SQLite database file location (default: ./dev.db)
# SQLITE_DB_PATH=dev.db
